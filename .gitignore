*.egg-info/
.DS_Store

# Regenerable thesis-figure output (canonical copies live in the thesis)
figures/
!thesis/assets/figures/
!thesis/assets/figures/*.png
scripts/*.npz

# Regenerable intermediates of scripts/lifecycle (mf_law.py, ablation.py rewrite them)
data/lifecycle/law_*.npz
data/lifecycle/ablation_*.npz

# Raw per-spell data of the headline runs (~110 MB); scripts/headline_spells.py regenerates it
data/headline_spells/

# Regenerable output of scripts/demographic (batch ~150 MB per point, facts ~60 MB)
data/demographic/

# Regenerable output of scripts/zerosum
data/zerosum/

# Bibliography files generated by revtex / biblatex
*Notes.bib
*-blx.bib
